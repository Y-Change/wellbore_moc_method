{
  "mode": "hard",
  "n_train": 1,
  "seed": 42,
  "cfg": {
    "schema_version": 1,
    "study": "stage2_pilot_preliminary",
    "split_seed": 20260906,
    "device_policy": "cuda if available else cpu",
    "data": {
      "window_periods": 4.0,
      "wellhead_decim": 4,
      "node_max_len": 128,
      "after_shut_in": true,
      "note": "Training grid Nyquist is wellhead_fs/2 after decim=4 (≈ 40–50 Hz typical). 70 Hz cluster-band is NOT certifiable on this grid or on node labels (Nyquist ≈ 11 Hz).\n"
    },
    "model": {
      "d": 64,
      "fno_d": 64,
      "fno_modes": 16,
      "name": "PilotPrototype",
      "gaps_vs_full_cjno": [
        "no characteristic-coordinate segment propagator",
        "no full-field trunk",
        "memory vs MOC z_l(x,t) pointwise left pending (no interior snapshots)"
      ]
    },
    "train": {
      "optimizer": "adam",
      "lr": 0.001,
      "weight_decay": 0.0,
      "batch_size": 4,
      "max_epochs_smoke": 3,
      "max_epochs_overfit256": 60,
      "max_epochs_full_train": 40,
      "early_stopping_patience": 12,
      "early_stopping_on": "val_pert_l2",
      "time_limit_s_overfit256": 3600,
      "time_limit_s_full": 5400,
      "grad_clip": 1.0,
      "apply_hard_times": 4,
      "seed_primary": 42,
      "seeds_extra_if_budget": [
        43,
        44
      ],
      "stages": [
        1,
        8,
        256,
        "all_train"
      ],
      "nest_sizes": [
        64,
        128,
        256,
        512,
        "all"
      ],
      "test_sealed_until_tuning_complete": true
    },
    "loss": {
      "w_head": 1.0,
      "w_node_soft": 0.25,
      "w_hard": 0.25,
      "report_absolute_and_perturbation": true,
      "zero_signal_rule": "silent if ||pert||_2 / ||state||_2 < 1e-6; do not enlarge epsilon"
    },
    "eval": {
      "metrics_frozen": [
        "wellhead_abs_state_l2",
        "wellhead_pert_l2",
        "peak_trough",
        "phase_err_over_4La",
        "psd",
        "node_H_Qm_Qp_sq",
        "node_resid_dimless",
        "finite_rollout"
      ],
      "cannot_certify": [
        "band_decay_0.05_1_1_10_10_100",
        "high_freq_peak_timing_70Hz",
        "full_field_L2",
        "memory_pointwise_vs_MOC_zl"
      ],
      "model_selection": "val_only",
      "test_is_not_formal_ood": true
    },
    "fairness": {
      "shared_split": true,
      "shared_norm_from_train": true,
      "shared_eval_code": true,
      "param_target_rel_tol": 0.2,
      "not_a_5seed_32trial_official_hpo": true
    }
  },
  "smoke": true,
  "device": "cpu"
}