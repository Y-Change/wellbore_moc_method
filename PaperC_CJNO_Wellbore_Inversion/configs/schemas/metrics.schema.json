{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "paperc/metrics.schema.json",
  "title": "PaperC stage metrics.json",
  "type": "object",
  "required": ["stage", "run_id", "code_digest", "config_digest", "git_commit", "gates"],
  "properties": {
    "stage": {"type": "integer"},
    "run_id": {"type": "string"},
    "code_digest": {"type": "string"},
    "config_digest": {"type": "string"},
    "manifest_digest": {"type": "string"},
    "git_commit": {"type": "string"},
    "gates": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["value", "threshold", "status"],
        "properties": {
          "value": {"type": ["number", "null", "string"]},
          "threshold": {"type": ["number", "string"]},
          "comparison": {"type": "string", "enum": ["<", "<=", ">", ">="]},
          "status": {"type": "string", "enum": ["PASS", "FAIL", "PENDING", "REPORT"]},
          "Cr": {"type": ["number", "string", "null"]},
          "notes": {"type": "string"}
        }
      }
    },
    "details": {"type": "object"}
  }
}
